<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/earth_header_bg"/>

        <!-- ECO BUDDY -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ecobuddy_avatar"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:padding="16dp"
                android:text="Hi! 👋 I'm EcoBuddy.\nI'm here to help you Search, Scan and Experiment!"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- SEARCH BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_search"/>

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search an object"
                android:paddingStart="10dp"/>

            <ImageView
                android:id="@+id/cameraButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_camera"/>
        </LinearLayout>

        <!-- SEARCH BUTTON -->

        <Button
            android:id="@+id/searchButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="SEARCH"/>

        <!-- POPULAR SEARCHES -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Popular Searches"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_margin="16dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/plasticIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_plastic"/>

                <ImageView
                    android:id="@+id/metalIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_metal"/>

                <ImageView
                    android:id="@+id/glassIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_glass"/>

                <ImageView
                    android:id="@+id/batteryIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_battery"/>

                <ImageView
                    android:id="@+id/paperIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_paper"/>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- LAB CARD -->

        <LinearLayout
            android:id="@+id/labCard"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_lab"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   Lab Experiments"
                android:textStyle="bold"
                android:textSize="22sp"/>
        </LinearLayout>

        <!-- QUOTE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp"
            android:text="❝ The Earth is what we all have in common. Let's keep it clean, green and beautiful. ❞"
            android:textSize="18sp"/>

    </LinearLayout>

</ScrollView>